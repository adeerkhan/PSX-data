{
  "name": "psx-data-api",
  "version": "0.1.0",
  "description": "Typed client for Pakistan Stock Exchange market data: live quotes, OHLCV history, indices, and sectors. Plain arrays and nulls, never formatted strings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeerkhan/PSX-data.git"
  },
  "bugs": {
    "url": "https://github.com/adeerkhan/PSX-data/issues"
  },
  "homepage": "https://github.com/adeerkhan/PSX-data#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "psx",
    "pakistan-stock-exchange",
    "kse100",
    "stock-market",
    "market-data",
    "ohlcv",
    "karachi",
    "finance",
    "typescript"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
